# Kopie van dit bestand heet .env. Het makkelijkst maak je die met: npm run setup

# Welke AI-dienst je gebruikt: gemini (gratis) of anthropic
PROVIDER=gemini

# Je sleutel van https://aistudio.google.com
GEMINI_API_KEY=

# Alleen nodig als PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Leeg laten voor het standaardmodel (gemini-3.5-flash of claude-sonnet-5)
MODEL=
